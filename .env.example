XHS_ENV=development
XHS_DATABASE_URL=sqlite:///./data/xhs_manager.db
XHS_OPERATOR_TIMEZONE=America/Los_Angeles
XHS_INTERNAL_API_TOKEN=replace-me

# 自定义群机器人只能发送通知；双向审批需要企业自建应用机器人。
XHS_FEISHU_CUSTOM_BOT_WEBHOOK=
XHS_FEISHU_VERIFICATION_TOKEN=
XHS_FEISHU_ALLOWED_USER_IDS=[]

# 第一阶段暂不启用真实发布。
XHS_PUBLISHING_ENABLED=false
XHS_COMMENTS_ENABLED=false

# ===== 视频 Pipeline =====
XHS_VIDEO_PIPELINE_ENABLED=false
XHS_VIDEO_DAILY_TRIGGER_HOUR=0
XHS_VIDEO_TOPICS_PER_RUN=3
XHS_VIDEO_MAX_DURATION=90
XHS_VIDEO_MIN_DURATION=30

# 热点采集
XHS_VIDEO_TREND_PLATFORMS=xiaohongshu,douyin,bilibili,twitter
XHS_VIDEO_TRENDS_PER_PLATFORM=20
XHS_VIDEO_TREND_KEYWORDS=AI,人工智能,大模型,AI工具,效率,自动化

# MoneyPrinterTurbo（已安装，首选素材+渲染工具）
XHS_VIDEO_MONEYPRINTER_PATH=/Users/xm/Desktop/xm_project/code/ai_agent_project/MoneyPrinterTurbo

# Pixelle-Video（备选）
XHS_VIDEO_PIXELLE_PATH=/Users/xm/Desktop/xm_project/code/ai_agent_project/Pixelle-Video

# 渲染模式: auto | moneyprinter | html
# auto = 混剪/评论型走 MoneyPrinterTurbo，讲解/数据可视化走 HTML
# moneyprinter = 全部用 MoneyPrinterTurbo 一站式生成
# html = 全部用 HTML 组合 + Playwright/ffmpeg 渲染
XHS_VIDEO_RENDER_MODE=auto
XHS_VIDEO_PIXELLE_API_URL=http://127.0.0.1:8080

# Pexels（免版权视频素材）
XHS_VIDEO_PEXELS_API_KEY=

# LLM
XHS_VIDEO_CLAUDE_API_KEY=
XHS_VIDEO_CLAUDE_MODEL=claude-sonnet-5

# TTS
XHS_VIDEO_TTS_PROVIDER=edge
XHS_VIDEO_TTS_VOICE=zh-CN-XiaoxiaoNeural
XHS_VIDEO_TTS_RATE=+10%

# 背景音乐（分段配乐：按场景情绪选曲、交叉淡化、旁白处自动压低）
XHS_VIDEO_BGM_ENABLED=true
# 曲库目录，逗号分隔。自己的音乐放 data/bgm/ 会自动纳入索引
XHS_VIDEO_BGM_DIRS=/Users/xm/Desktop/xm_project/code/ai_agent_project/MoneyPrinterTurbo/resource/songs,data/bgm
XHS_VIDEO_BGM_INDEX_PATH=data/video_pipeline/bgm_index.json

# 渲染
XHS_VIDEO_RENDER_FPS=30
XHS_VIDEO_RENDER_RESOLUTION=1080x1920

# 发布平台
XHS_VIDEO_PUBLISH_PLATFORMS=xiaohongshu
XHS_VIDEO_PUBLISH_DELAY_MINUTES=5
# 小红书视频发布模式：draft=暂存离线（默认，人工确认后发布） | publish=直接发布
XHS_VIDEO_XHS_PUBLISH_MODE=draft
XHS_VIDEO_XHS_BROWSER_SESSION=xhs-video
# 小红书草稿存浏览器本地：要让草稿出现在你自己的 Chrome 里，
# 需带调试端口启动 Chrome 并填此项；留空则用独立 profile（草稿仅在该 profile 可见）
#   "/Applications/Google Chrome.app/Contents/MacOS/Google Chrome" --remote-debugging-port=9222
XHS_VIDEO_XHS_CDP_URL=

# 输出目录
XHS_VIDEO_OUTPUT_BASE_DIR=data/video_pipeline
